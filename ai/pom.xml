<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation=" http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.ai.rca</groupId>
        <artifactId>quarkus-ai-rca-parent</artifactId>
        <version>0.1.5-SNAPSHOT</version>
    </parent>

    <artifactId>quarkus-ai-rca-core</artifactId>
    <packaging>jar</packaging>

    <name>Quarkus AI RCA Core</name>
    <description>AI abstractions and integration layer (no LLM providers)</description>

    <!-- ===================== -->
    <!-- Properties            -->
    <!-- ===================== -->
    <properties>
        <quarkus.package.jar.type>uber-jar</quarkus.package.jar.type>
        <evaluation.threshold>70</evaluation.threshold>
        <!-- TODO [elastic-release] Remove; only needed to forward lgtm.enabled to surefire (elastic profile sets it to false) -->
        <quarkus.observability.lgtm.enabled>true</quarkus.observability.lgtm.enabled>
        <!-- TODO [elastic-release] Remove; only needed to forward incompatible-extensions=warn to surefire (elastic profile overrides to warn) -->
        <quarkus.bootstrap.incompatible-extensions>error</quarkus.bootstrap.incompatible-extensions>
    </properties>

    <!-- ===================== -->
    <!-- Dependencies          -->
    <!-- ===================== -->
    <dependencies>
        <!-- Common (SPI + utilities) -->
        <dependency>
            <groupId>io.quarkiverse.ai.rca</groupId>
            <artifactId>quarkus-ai-rca-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- LangChain4j MCP (always needed) -->
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-mcp</artifactId>
        </dependency>

        <!-- REST -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-testing-evaluation-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.resiliencytesting</groupId>
            <artifactId>quarkus-resiliency-testing-junit</artifactId>
            <version>${quarkus.resiliency-testing.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.resiliencytesting</groupId>
            <artifactId>quarkus-resiliency-testing-langchain4j</artifactId>
            <version>${quarkus.resiliency-testing.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===================== -->
    <!-- Build                 -->
    <!-- ===================== -->
    <build>
        <plugins>

            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <integration.run>${integration.run}</integration.run>
                        <evaluation.threshold>${evaluation.threshold}</evaluation.threshold>
                        <observability.platform>${observability.platform}</observability.platform>
                        <!-- TODO [elastic-release] Remove; forwards lgtm.enabled=false to forked test JVM when elastic profile is active -->
                        <quarkus.observability.lgtm.enabled>${quarkus.observability.lgtm.enabled}</quarkus.observability.lgtm.enabled>
                        <!-- TODO [elastic-release] Remove; forwards incompatible-extensions=warn to forked test JVM for 999-SNAPSHOT modules -->
                        <quarkus.bootstrap.incompatible-extensions>${quarkus.bootstrap.incompatible-extensions}</quarkus.bootstrap.incompatible-extensions>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- ===================== -->
    <!-- Profiles              -->
    <!-- ===================== -->
    <profiles>

        <!-- =============================== -->
        <!-- Observability platform profiles -->
        <!-- =============================== -->

        <profile>
            <id>lgtm</id>
            <activation>
                <property>
                    <name>observability.platform</name>
                    <value>lgtm</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.ai.rca</groupId>
                    <artifactId>quarkus-ai-rca-lgtm</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-observability-devservices-lgtm</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>elastic</id>
            <activation>
                <property>
                    <name>observability.platform</name>
                    <value>elastic</value>
                </property>
            </activation>
            <!--
                TODO [elastic-release] Remove these two properties when Elastic Dev Services ship in a Quarkus release.
                - incompatible-extensions=warn: suppresses version-range check for 999-SNAPSHOT modules
                - lgtm.enabled=false: prevents LGTM dev service from starting alongside Elastic
            -->
            <properties>
                <quarkus.bootstrap.incompatible-extensions>warn</quarkus.bootstrap.incompatible-extensions>
                <quarkus.observability.lgtm.enabled>false</quarkus.observability.lgtm.enabled>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.ai.rca</groupId>
                    <artifactId>quarkus-ai-rca-elastic</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <!--
                    TODO [elastic-release] Remove explicit versions below; they will come from the Quarkus BOM.
                    Currently overridden to 999-SNAPSHOT because the released BOM does not include them yet.
                -->
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-observability-devservices-elastic</artifactId>
                    <version>${quarkus.observability.elastic.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-observability-testcontainers</artifactId>
                    <version>${quarkus.observability.elastic.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-observability-devresource-testcontainers</artifactId>
                    <version>${quarkus.observability.elastic.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-observability-devservices</artifactId>
                    <version>${quarkus.observability.elastic.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-observability-devservices-common</artifactId>
                    <version>${quarkus.observability.elastic.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-observability-devresource-common</artifactId>
                    <version>${quarkus.observability.elastic.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <!-- =============================== -->
        <!-- LLM provider profiles           -->
        <!-- =============================== -->

        <profile>
            <id>openai</id>
            <activation>
                <property>
                    <name>llm.provider</name>
                    <value>openai</value>
                </property>
            </activation>
            <properties>
                <quarkus.profile>openai</quarkus.profile>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.langchain4j</groupId>
                    <artifactId>quarkus-langchain4j-openai</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!-- Grok (xAI) — reuses OpenAI extension with different base-url -->
        <profile>
            <id>grok</id>
            <activation>
                <property>
                    <name>llm.provider</name>
                    <value>grok</value>
                </property>
            </activation>
            <properties>
                <quarkus.profile>grok</quarkus.profile>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.langchain4j</groupId>
                    <artifactId>quarkus-langchain4j-openai</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!-- Gemini -->
        <profile>
            <id>gemini</id>
            <activation>
                <property>
                    <name>llm.provider</name>
                    <value>gemini</value>
                </property>
            </activation>
            <properties>
                <quarkus.profile>gemini</quarkus.profile>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.langchain4j</groupId>
                    <artifactId>quarkus-langchain4j-ai-gemini</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/GrokChatModelCustomizer.java</exclude>
                                <exclude>**/GrokScorerChatModelCustomizer.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- WatsonX -->
        <profile>
            <id>watsonx</id>
            <activation>
                <property>
                    <name>llm.provider</name>
                    <value>watsonx</value>
                </property>
            </activation>
            <properties>
                <quarkus.profile>watsonx</quarkus.profile>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.langchain4j</groupId>
                    <artifactId>quarkus-langchain4j-watsonx</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/GrokChatModelCustomizer.java</exclude>
                                <exclude>**/GrokScorerChatModelCustomizer.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>

